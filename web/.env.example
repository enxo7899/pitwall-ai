# Settings for the website's answer route (server side only; never exposed to the browser).
# Copy to .env.local for local development, or set them in the Vercel project settings.

# A read-only Hugging Face token: live answers then use your account's ZeroGPU allowance
# instead of the small anonymous one. Create it at https://huggingface.co/settings/tokens
HF_TOKEN=

# The engine's access key: a long random string, stored both here and as the PITWALL_KEY secret of the
# Hugging Face Space. The engine refuses any request without it, so only this site can use it.
PITWALL_KEY=

# The inference engine Space (optional; this is the default)
PITWALL_SPACE=enxo7899/pitwall-ai
