# Copy of the keys PITWALL AI needs. Fill these in `.env` (same names), never here.
# `.env` is git-ignored. Never paste a key into a chat, a commit or a screenshot.
# Each key is only needed from its gate onwards. Check what a gate needs with:
#   uv run python scripts/tools/check_env.py --gate 1   (prints set / missing, never values)

# Judge and test-question drafting (Gates 2 and 5) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Publishing the adapter (Gate 4); token needs WRITE access — https://huggingface.co/settings/tokens
HF_TOKEN=

# Starting and stopping GPU pods: training (Gates 1, 4, 5) and the self-hosted
# training-data teacher (Gate 3) — https://www.runpod.io/
RUNPOD_API_KEY=
